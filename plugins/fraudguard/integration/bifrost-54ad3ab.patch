diff --git a/transports/bifrost-http/server/fraudguard_plugin_test.go b/transports/bifrost-http/server/fraudguard_plugin_test.go
new file mode 100644
--- /dev/null
+++ b/transports/bifrost-http/server/fraudguard_plugin_test.go
@@ -0,0 +1,32 @@
+package server
+
+import (
+	"context"
+	"testing"
+
+	"github.com/maximhq/bifrost/core/schemas"
+	"github.com/maximhq/bifrost/plugins/fraudguard"
+	"github.com/maximhq/bifrost/transports/v2/bifrost-http/lib"
+)
+
+func TestFraudGuardBuiltinPluginLoadsAndPassesThrough(t *testing.T) {
+	if !lib.IsBuiltinPlugin(fraudguard.PluginName) {
+		t.Fatal("FraudGuard is not registered as a built-in plugin")
+	}
+	plugin, err := InstantiatePlugin(context.Background(), fraudguard.PluginName, nil, map[string]any{}, &lib.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	llmPlugin, ok := plugin.(schemas.LLMPlugin)
+	if !ok {
+		t.Fatal("FraudGuard does not implement schemas.LLMPlugin")
+	}
+	request := &schemas.BifrostRequest{}
+	got, shortCircuit, err := llmPlugin.PreLLMHook(nil, request)
+	if err != nil || shortCircuit != nil || got != request {
+		t.Fatalf("hook did not preserve the request: same=%t short=%v err=%v", got == request, shortCircuit, err)
+	}
+	if err := plugin.Cleanup(); err != nil {
+		t.Fatal(err)
+	}
+}
