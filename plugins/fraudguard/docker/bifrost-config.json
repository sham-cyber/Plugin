{
  "$schema": "file:///app/config.schema.json",
  "version": 1,
  "client": {
    "enforce_auth_on_inference": true,
    "disable_content_logging": true
  },
  "framework": {
    "pricing": {
      "pricing_url": "file:///app/fraudguard-pricing.json",
      "pricing_sync_interval": 86400,
      "model_parameters_url": "file:///app/fraudguard-model-parameters.json",
      "mcp_library_url": "file:///app/fraudguard-mcp-library.json",
      "mcp_library_sync_interval": 86400
    }
  },
  "providers": {
    "vllm-local": {
      "keys": [
        {
          "id": "fraudguard-demo-key",
          "name": "fraudguard-demo-key",
          "value": "local-demo-only",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://mock-provider:9090",
        "allow_private_network": true,
        "default_request_timeout_in_seconds": 10
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": false
        }
      }
    }
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "fraudguard-demo-vk",
        "name": "FraudGuard local synthetic demo",
        "value": "sk-bf-fraudguard-local-demo",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "vllm-local",
            "allowed_models": ["*"],
            "key_ids": ["fraudguard-demo-key"],
            "weight": 1.0
          }
        ]
      }
    ]
  },
  "plugins": [
    {
      "name": "fraudguard",
      "enabled": true,
      "path": "/app/plugins/fraudguard.so",
      "config": {
        "alert_threshold": 60,
        "warmup_requests": 1,
        "max_profiles": 10000,
        "enable_prompt_override_signals": true,
        "enable_context_guard": true,
        "max_context_messages": 16,
        "max_context_scan_bytes": 65536
      }
    }
  ]
}
